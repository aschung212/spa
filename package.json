{
  "name": "lift",
  "version": "1.0.0",
  "type": "module",
  "description": "A PWA workout tracker for logging sets, tracking progress, and hitting PRs.",
  "scripts": {
    "css:extract-themes": "node scripts/rewrite-css.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-launch-screens": "node scripts/generate-launch-screens.js",
    "generate-wide-screenshot": "node scripts/generate-wide-screenshot.js",
    "test": "vitest run",
    "guard:dev-signin": "node scripts/check-no-dev-signin.js",
    "test:browser": "vitest run --config vitest.browser.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase migration up",
    "db:new": "npx supabase migration new",
    "db:status": "npx supabase migration list",
    "db:diff": "npx supabase db diff",
    "db:types": "npx supabase gen types --linked --lang typescript 2>/dev/null > src/lib/database.types.ts",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "cap:build": "CAPACITOR_BUILD=true npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@sentry/vue": "^10.73.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "modern-screenshot": "^4.7.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue}": [
      "eslint --max-warnings 5"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.4",
    "esbuild": ">=0.25.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "nanoid": "^3.3.18",
    "tar": "^7.5.21"
  }
}
